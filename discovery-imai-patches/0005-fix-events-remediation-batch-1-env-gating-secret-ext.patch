diff --git a/backend/main/src/tests/event-dictionary-sync.spec.ts b/backend/main/src/tests/event-dictionary-sync.spec.ts
new file mode 100644
index 00000000..7d96052b
--- /dev/null
+++ b/backend/main/src/tests/event-dictionary-sync.spec.ts
@@ -0,0 +1,97 @@
+import * as fs from 'fs';
+import * as path from 'path';
+
+/**
+ * Guardrail (R21, docs/events-audit/10-gaps-and-remediation.md): every event
+ * name emitted to the analytics webhook must be documented in the event
+ * dictionary. New events land here failing until the author adds a dictionary
+ * entry — keeping docs/events-audit/02-event-dictionary.md the single source
+ * of truth for what the platform emits.
+ *
+ * Static analysis only: call sites that pass a variable as `event` are
+ * skipped, and the dynamic `trial_*` families are allowed by prefix (their
+ * placements/features are enumerated in the dictionary §5).
+ */
+
+const REPO_ROOT = path.resolve(__dirname, '..', '..', '..', '..');
+const DICTIONARY_PATH = path.join(REPO_ROOT, 'docs', 'events-audit', '02-event-dictionary.md');
+
+const EMITTER_CALL = /sendPipeDriveWebhook\s*\(/g;
+// From an `event:` field, collect every quoted snake_case token so ternaries
+// like `event: isTrial ? 'cancel_trial' : 'cancel_subscription'` yield both.
+const EVENT_FIELD = /event:\s*([^,}\n]*(?:\n[^,}\n]*)?)/;
+const QUOTED_NAME = /['"]([a-z][a-z0-9_]*)['"]/g;
+
+const ALLOWED_DYNAMIC_PREFIXES = ['trial_'];
+
+function walk(dir: string, out: string[] = []): string[] {
+  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
+    if (entry.name === 'node_modules' || entry.name === 'dist' || entry.name.startsWith('.')) {
+      continue;
+    }
+    const full = path.join(dir, entry.name);
+    if (entry.isDirectory()) {
+      walk(full, out);
+    } else if (/\.(ts|js)$/.test(entry.name) && !/\.spec\.(ts|js)$/.test(entry.name)) {
+      out.push(full);
+    }
+  }
+  return out;
+}
+
+function extractEmittedEvents(files: string[]): Map<string, string[]> {
+  const events = new Map<string, string[]>();
+  for (const file of files) {
+    const source = fs.readFileSync(file, 'utf8');
+    let match: RegExpExecArray | null;
+    EMITTER_CALL.lastIndex = 0;
+    while ((match = EMITTER_CALL.exec(source)) !== null) {
+      const window = source.slice(match.index, match.index + 500);
+      const eventField = EVENT_FIELD.exec(window);
+      if (!eventField) continue;
+      let quoted: RegExpExecArray | null;
+      QUOTED_NAME.lastIndex = 0;
+      while ((quoted = QUOTED_NAME.exec(eventField[1])) !== null) {
+        const name = quoted[1];
+        const sites = events.get(name) || [];
+        sites.push(path.relative(REPO_ROOT, file));
+        events.set(name, sites);
+      }
+    }
+  }
+  return events;
+}
+
+describe('event dictionary sync', () => {
+  it('documents every statically-named webhook event', () => {
+    expect(fs.existsSync(DICTIONARY_PATH)).toBe(true);
+
+    const dictionary = fs.readFileSync(DICTIONARY_PATH, 'utf8');
+    const documented = new Set<string>();
+    for (const m of dictionary.matchAll(/`([a-z][a-z0-9_]*)`/g)) {
+      documented.add(m[1]);
+    }
+
+    const files = [
+      ...walk(path.join(REPO_ROOT, 'backend', 'main', 'src')),
+      ...walk(path.join(REPO_ROOT, 'backend', 'social-listening', 'src')),
+      path.join(REPO_ROOT, 'proxy', 'index.js'),
+    ].filter((f) => fs.existsSync(f));
+
+    const emitted = extractEmittedEvents(files);
+    const undocumented: string[] = [];
+    for (const [name, sites] of emitted) {
+      if (documented.has(name)) continue;
+      if (ALLOWED_DYNAMIC_PREFIXES.some((p) => name.startsWith(p))) continue;
+      undocumented.push(`${name} (${[...new Set(sites)].join(', ')})`);
+    }
+
+    expect(emitted.size).toBeGreaterThan(20); // extraction sanity floor
+    if (undocumented.length > 0) {
+      throw new Error(
+        `Undocumented analytics events — add them to docs/events-audit/02-event-dictionary.md:\n` +
+          undocumented.map((u) => `  - ${u}`).join('\n'),
+      );
+    }
+  });
+});
